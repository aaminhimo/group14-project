%% Data model / ERD for the Energy Database (SQLite). Implemented in src/backend/app/models.py
erDiagram
  MEASUREMENT {
    int id PK
    datetime timestamp UK "10-minute step"
    int appliances_wh "target"
    int lights_wh
    float t1 "kitchen"
    float rh_1
    float t2_to_t9 "T2..T9, RH_2..RH_9 (one column each)"
    float t_out "weather station"
    float press_mm_hg
    float rh_out
    float windspeed
    float visibility
    float tdewpoint
  }
  MODEL_RUN {
    int id PK
    string version UK
    string algorithm
    datetime trained_at
    float val_mae
    float test_mae
    float test_rmse
    float test_r2
    string artifact_path
  }
  PREDICTION {
    int id PK
    int measurement_id FK "null for what-if"
    int model_run_id FK
    string source "whatif | compare | replay"
    json input_features
    float predicted_wh
    datetime created_at
  }
  REPLAY_SESSION {
    int id PK
    datetime start_ts
    datetime cursor_ts
    int speed
    float threshold_wh
    string status "running | paused | finished"
    datetime created_at
  }
  ALERT {
    int id PK
    int replay_session_id FK
    int prediction_id FK
    datetime reading_ts
    float value_wh
    float threshold_wh
    string kind "predicted | actual"
    datetime created_at
  }

  MEASUREMENT ||--o{ PREDICTION : "is predicted by"
  MODEL_RUN ||--o{ PREDICTION : "produces"
  REPLAY_SESSION ||--o{ ALERT : "raises"
  PREDICTION ||--o| ALERT : "may trigger"
